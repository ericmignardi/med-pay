# =============================================================================
# MedPay Ledger — environment template
#
# Copy to `.env` and fill in real values. `.env` is git-ignored and must never
# be committed. This file carries placeholders only (NFR-007).
#
#   cp .env.example .env
#
# Consumed by: docker-compose.yml (local dev) and docker-compose.prod.yml.
# In Azure these become App Service application settings; the two marked
# KEY VAULT below are stored as Key Vault references, not plain settings.
# =============================================================================

# -----------------------------------------------------------------------------
# Spring profile
#   dev   — local development, permissive CORS for the Vite dev server
#   demo  — dev plus DemoDataSeeder (sample claims for the Playwright suite)
#   prod  — Azure; no CORS bean registered at all (ADR-006)
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=demo

# -----------------------------------------------------------------------------
# PostgreSQL — local compose container only.
# Not used against Azure Database for PostgreSQL Flexible Server; there the
# `db` service is omitted and SPRING_DATASOURCE_URL points at the managed server.
# -----------------------------------------------------------------------------
POSTGRES_DB=medpay
POSTGRES_USER=medpay
POSTGRES_PASSWORD=change-me-locally

# -----------------------------------------------------------------------------
# Backend datasource
#
# Local (compose network, service name `db`):
#   jdbc:postgresql://db:5432/medpay
#
# Azure (SSL is mandatory — NFR-003):
#   jdbc:postgresql://medpay-pg.postgres.database.azure.com:5432/medpay?sslmode=require
#
# SPRING_DATASOURCE_PASSWORD is a KEY VAULT reference in Azure:
#   @Microsoft.KeyVault(SecretUri=https://medpay-kv.vault.azure.net/secrets/db-password/)
# -----------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/medpay
SPRING_DATASOURCE_USERNAME=medpay
SPRING_DATASOURCE_PASSWORD=change-me-locally

# -----------------------------------------------------------------------------
# JWT signing (FR-002, NFR-002)
#
# MEDPAY_JWT_SECRET must decode to at least 32 bytes (256 bits) or
# JwtTokenProvider throws IllegalStateException at startup — fail fast, not at
# first login. Generate one with:
#
#   openssl rand -base64 48
#
# In Azure this is a KEY VAULT reference:
#   @Microsoft.KeyVault(SecretUri=https://medpay-kv.vault.azure.net/secrets/jwt-secret/)
#
# TTL is 3600 seconds (60 minutes). There is no refresh token and no revocation
# list in v1 — the exposure window for a stolen token is the remaining TTL
# (NFR-004, accepted and documented).
# -----------------------------------------------------------------------------
MEDPAY_JWT_SECRET=replace-with-openssl-rand-base64-48-output
MEDPAY_JWT_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# CORS (dev profile only — ADR-006)
#
# Set only when running the Vite dev server directly against the backend on
# :8080. Under compose and in Azure, Nginx proxies /api/v1 so every request is
# same-origin and no CORS bean is registered. A wildcard value here would
# violate NFR-006 — do not use `*`.
# -----------------------------------------------------------------------------
MEDPAY_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# -----------------------------------------------------------------------------
# Container images (docker-compose.prod.yml)
#
# IMAGE_TAG is the short commit SHA written by the deploy workflow. `latest` is
# pushed but never deployed — rollback is a redeploy of a prior SHA.
# -----------------------------------------------------------------------------
ACR_LOGIN_SERVER=medpayacr.azurecr.io
IMAGE_TAG=local

# -----------------------------------------------------------------------------
# Observability (Azure only; leave blank locally)
# -----------------------------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=

# -----------------------------------------------------------------------------
# App Service (set in the Azure portal / Bicep, not here)
#
#   WEBSITES_PORT=80
#   DOCKER_REGISTRY_SERVER_URL=https://medpayacr.azurecr.io
#
# CI credentials are GitHub repository secrets, not environment variables, and
# use OIDC federated identity — there is no long-lived service principal secret:
#
#   AZURE_CLIENT_ID / AZURE_TENANT_ID / AZURE_SUBSCRIPTION_ID
# -----------------------------------------------------------------------------
